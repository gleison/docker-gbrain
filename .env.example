# Use somente caracteres seguros para URL; uma senha hexadecimal é recomendada.
# Gere uma com: openssl rand -hex 32
GBRAIN_POSTGRES_PASSWORD=troque-por-uma-senha-hexadecimal-longa

# Token de administração do GBrain. Gere outro valor com: openssl rand -hex 32
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=troque-por-outro-segredo-hexadecimal-longo

# Imagem do llama.cpp. Em servidor NVIDIA, use uma variante server-cuda
# compatível com o CUDA instalado e configure o acesso à GPU no Compose.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Modelos GGUF no Hugging Face. O llama-server baixa e mantém os arquivos
# automaticamente no diretório ~/.tmp/.llama do host.
LLAMA_EMBEDDING_ALIAS=Qwen3-Embedding-0.6B
LLAMA_EMBEDDING_MODEL=Qwen/${LLAMA_EMBEDDING_ALIAS}-GGUF:Q8_0
LLAMA_CHAT_ALIAS=Qwen3-4B-Instruct-2507
LLAMA_CHAT_MODEL=ggml-org/${LLAMA_CHAT_ALIAS}-Q8_0-GGUF:Q8_0
LLAMA_RERANKER_ALIAS=Qwen3-Reranker-0.6B
LLAMA_RERANKER_MODEL=ggml-org/${LLAMA_RERANKER_ALIAS}-Q8_0-GGUF:Q8_0
