# Use somente caracteres seguros para URL; uma senha hexadecimal é recomendada.
# Gere uma com: openssl rand -hex 32
GBRAIN_POSTGRES_PASSWORD=troque-por-uma-senha-hexadecimal-longa

# Token de administração do GBrain. Gere outro valor com: openssl rand -hex 32
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=troque-por-outro-segredo-hexadecimal-longo
